NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key_here
# SUPABASE_SECRET_KEY=your_server_only_secret_key_here
# Direct database connection. Use Shared Pooler instead if your network does not support IPv6.
SUPABASE_DATABASE_URL=postgresql://postgres:your_database_password@db.your-project-ref.supabase.co:5432/postgres
RESEND_API_KEY=re_your_server_only_resend_key_here
RESEND_FROM_EMAIL="Reliance Notifications <notifications@reliancepredictivesafety.com>"
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here
EMPLOYEE_MAIL_DOMAIN=mail.reliancepredictivesafety.com
EMPLOYEE_MAIL_FROM_NAME="Reliance"
CRON_SECRET=replace_with_a_long_random_value
NEXT_PUBLIC_SITE_URL=https://reliancepredictivesafetytechnologies.com
# Vercel AI Gateway. Use AI_GATEWAY_API_KEY locally, or enable OIDC in Vercel project settings.
AI_GATEWAY_API_KEY=your_server_only_ai_gateway_key_here
AI_COMMAND_MODEL=openai/gpt-4o
# OpenAI API key — used directly by the Legal Register research tool (Responses API + web search)
OPENAI_API_KEY=sk-your_openai_api_key_here
# Model for legal research. Must be enabled on your OpenAI project and support web_search_preview.
OPENAI_RESEARCH_MODEL=gpt-4o-mini
# Optional model for the AI Document Builder (SOP/Policy generation). Falls back to
# OPENAI_RESEARCH_MODEL, then gpt-4o-mini. No web search required.
OPENAI_DOCUMENT_MODEL=gpt-4o-mini
# VERCEL_OIDC_TOKEN=managed_by_vercel_env_pull
# TURN server for WebRTC video calls behind enterprise/symmetric NAT (optional but recommended for production)
# Free option: https://www.metered.ca/tools/openrelay  or  Twilio Network Traversal Service
TURN_URLS=turn:your-turn-server.example.com:3478,turns:your-turn-server.example.com:5349
TURN_USERNAME=your_turn_username_here
TURN_CREDENTIAL=your_turn_credential_here
# Optional model override for AI lead triage. Falls back to OPENAI_RESEARCH_MODEL, then gpt-4o-mini.
OPENAI_LEAD_TRIAGE_MODEL=gpt-4o-mini
# Optional vision-capable model for the Employee Expenses "AI autofill from receipt"
# action. Falls back to OPENAI_DOCUMENT_MODEL, then gpt-4o-mini.
OPENAI_RECEIPT_MODEL=gpt-4o-mini
# Platform-wide daily AI spend cap in cents, used by lib/ai/metering.ts until the
# platform_ai_budget_settings row exists.
AI_BUDGET_DEFAULT_CAP_CENTS=500

# DocuSign eSignature integration. Use the demo URLs for sandbox testing and
# production URLs only after the integration key is live in DocuSign.
DOCUSIGN_ENABLED=false
DOCUSIGN_INTEGRATION_KEY=your_docusign_integration_key_here
DOCUSIGN_USER_ID=your_docusign_impersonated_user_guid_here
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id_here
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
DOCUSIGN_OAUTH_BASE_URL=https://account-d.docusign.com
DOCUSIGN_BASE_PATH=https://demo.docusign.net
DOCUSIGN_WEBHOOK_SECRET=replace_with_docusign_connect_hmac_secret
DOCUSIGN_DEFAULT_EMAIL_SUBJECT=
